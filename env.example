# Скопируй этот файл в .env и вставь реальные значения.
# Файл .env добавлен в .gitignore и НИКОГДА не попадает в репозиторий.

# Ключ OpenRouter (доступ к модели Claude)
OPENROUTER_API_KEY=sk-or-вставь-сюда-свой-ключ

# Секрет для доступа к HTTP-эндпоинту агента.
# Клиенты обязаны передавать его в заголовке X-API-Key.
# Придумай любую длинную случайную строку.
AGENT_API_KEY=придумай-свой-секрет
